Cell[CellGroupData[{

Cell["6. Walk-Forward Backtesting (Rolling Window Evaluation)", "Section",ExpressionUUID->"8c564f77-6b97-4e88-b977-e2def00fe405"],

Cell["\<\
To rigorously verify model performance across differing market regimes (bull \
runs, pullbacks, and consolidations), we execute a walk-forward rolling \
backtest across 16 consecutive 20-day evaluation horizons spanning \
2023\[Dash]2024.\
\>", "Text",ExpressionUUID->"dcd4dbcc-7be3-43f9-9993-1e9e8f1af5be"],

Cell["In each window:", "Text",ExpressionUUID->"7eb4ae48-7696-4567-b019-99e4a60d61bb"],

Cell["\<\
1. Models are trained on the preceding 250 trading days (1-year lookback).\
\>", "Text",ExpressionUUID->"3aaacb1d-59d4-4c2f-b0ad-194a3ba7bf16"],

Cell["\<\
2. Models forecast expected average price over the subsequent 20 trading days.\
\>", "Text",ExpressionUUID->"c7c1c6a8-95bf-4672-80a3-fdb06e5e53a9"],

Cell["\<\
3. Errors relative to realized prices are systematically recorded. \
\>", "Text",ExpressionUUID->"aba5640b-a58d-4899-96a4-5d5b48fec723"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Walk", "-", 
    RowBox[{"Forward", " ", "Rolling", " ", "Evaluation", " ", "Engine"}]}], 
   " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"windowLookback", "=", "250"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"evalHorizon", "=", "20"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"stepSize", "=", "15"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rollingResults", "=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"results", "=", 
          RowBox[{"{", "}"}]}], ",", "tStart", ",", "tEnd", ",", "fEnd", ",", 
         "train", ",", "future", ",", "\[IndentingNewLine]", 
         "                         ", "muK", ",", "betaK", ",", "kRes", ",", 
         "kalmanFC", ",", "kalmanAvg", ",", "\[IndentingNewLine]", 
         "                         ", "logR", ",", "armaFit", ",", "armaFC", ",",
          "armaAvg", ",", "\[IndentingNewLine]", "                         ", 
         "actAvg", ",", "naiveAvg", ",", "pTerminal"}], "}"}], ",", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{
        RowBox[{"Do", "[", "\[IndentingNewLine]", "    ", 
         RowBox[{
          RowBox[{
           RowBox[{"tStart", "=", "i"}], ";", "\[IndentingNewLine]", "    ", 
           RowBox[{"tEnd", "=", 
            RowBox[{"i", "+", "windowLookback", "-", "1"}]}], ";", 
           "\[IndentingNewLine]", "    ", 
           RowBox[{"fEnd", "=", 
            RowBox[{"tEnd", "+", "evalHorizon"}]}], ";", 
           "\[IndentingNewLine]", "    ", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"fEnd", ">", "nTotal"}], ",", 
             RowBox[{"Break", "[", "]"}]}], "]"}], ";", "\[IndentingNewLine]",
            "    ", "\[IndentingNewLine]", "    ", 
           RowBox[{"train", "=", 
            RowBox[{"rawPrices", "[", 
             RowBox[{"[", 
              RowBox[{"tStart", " ", ";;", " ", "tEnd"}], "]"}], "]"}]}], ";",
            "\[IndentingNewLine]", "    ", 
           RowBox[{"future", "=", 
            RowBox[{"rawPrices", "[", 
             RowBox[{"[", 
              RowBox[{
               RowBox[{"tEnd", "+", "1"}], " ", ";;", " ", "fEnd"}], "]"}], 
             "]"}]}], ";", "\[IndentingNewLine]", "    ", 
           RowBox[{"pTerminal", "=", 
            RowBox[{"Last", "[", "train", "]"}]}], ";", "\[IndentingNewLine]",
            "    ", 
           RowBox[{"actAvg", "=", 
            RowBox[{"Mean", "[", "future", "]"}]}], ";", 
           "\[IndentingNewLine]", "    ", 
           RowBox[{"naiveAvg", "=", "pTerminal"}], ";", "\[IndentingNewLine]",
            "    ", "\[IndentingNewLine]", "    ", 
           RowBox[{"(*", " ", 
            RowBox[{
            "1.", " ", "Kalman", " ", "Linear", " ", "Trend", " ", "Filter"}],
             " ", "*)"}], "\[IndentingNewLine]", "    ", 
           RowBox[{"kRes", "=", 
            RowBox[{"kalmanTrendFilter", "[", 
             RowBox[{"train", ",", "1.0", ",", "0.05", ",", "5.0"}], "]"}]}], 
           ";", "\[IndentingNewLine]", "    ", 
           RowBox[{"muK", "=", 
            RowBox[{
             RowBox[{"kRes", "[", "\"\<FinalState\>\"", "]"}], "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
           "    ", 
           RowBox[{"betaK", "=", 
            RowBox[{
             RowBox[{"kRes", "[", "\"\<FinalState\>\"", "]"}], "[", 
             RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
           "    ", 
           RowBox[{"kalmanFC", "=", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"muK", "+", 
               RowBox[{"k", "*", "betaK"}]}], ",", 
              RowBox[{"{", 
               RowBox[{"k", ",", "1", ",", "evalHorizon"}], "}"}]}], "]"}]}], 
           ";", "\[IndentingNewLine]", "    ", 
           RowBox[{"kalmanAvg", "=", 
            RowBox[{"Mean", "[", "kalmanFC", "]"}]}], ";", 
           "\[IndentingNewLine]", "    ", "\[IndentingNewLine]", "    ", 
           RowBox[{"(*", " ", 
            RowBox[{
            "2.", " ", "ARMA", " ", "on", " ", "Log", " ", "Returns"}], " ", 
            "*)"}], "\[IndentingNewLine]", "    ", 
           RowBox[{"logR", "=", 
            RowBox[{"Differences", "[", 
             RowBox[{"Log", "[", "train", "]"}], "]"}]}], ";", 
           "\[IndentingNewLine]", "    ", 
           RowBox[{"armaFit", "=", 
            RowBox[{"Quiet", "@", 
             RowBox[{"TimeSeriesModelFit", "[", 
              RowBox[{"logR", ",", "\"\<ARMA\>\""}], "]"}]}]}], ";", 
           "\[IndentingNewLine]", "    ", 
           RowBox[{"armaFC", "=", 
            RowBox[{"Quiet", "@", 
             RowBox[{
              RowBox[{"TimeSeriesForecast", "[", 
               RowBox[{"armaFit", ",", 
                RowBox[{"{", "evalHorizon", "}"}]}], "]"}], 
              "[", "\"\<Values\>\"", "]"}]}]}], ";", "\[IndentingNewLine]", 
           "    ", 
           RowBox[{"armaAvg", "=", 
            RowBox[{"Mean", "[", 
             RowBox[{"pTerminal", "*", 
              RowBox[{"Exp", "[", 
               RowBox[{"Accumulate", "[", "armaFC", "]"}], "]"}]}], "]"}]}], ";",
            "\[IndentingNewLine]", "    ", "\[IndentingNewLine]", "    ", 
           RowBox[{"AppendTo", "[", 
            RowBox[{"results", ",", 
             RowBox[{"<|", "\[IndentingNewLine]", "      ", 
              RowBox[{
               RowBox[{"\"\<Window\>\"", "->", 
                RowBox[{
                 RowBox[{"Length", "[", "results", "]"}], "+", "1"}]}], ",", 
               "\[IndentingNewLine]", "      ", 
               RowBox[{"\"\<EndDay\>\"", "->", "tEnd"}], ",", 
               "\[IndentingNewLine]", "      ", 
               RowBox[{"\"\<ActualAvg\>\"", "->", "actAvg"}], ",", 
               "\[IndentingNewLine]", "      ", 
               RowBox[{"\"\<ARMAAvg\>\"", "->", "armaAvg"}], ",", 
               "\[IndentingNewLine]", "      ", 
               RowBox[{"\"\<KalmanAvg\>\"", "->", "kalmanAvg"}], ",", 
               "\[IndentingNewLine]", "      ", 
               RowBox[{"\"\<NaiveAvg\>\"", "->", "naiveAvg"}], ",", 
               "\[IndentingNewLine]", "      ", 
               RowBox[{"\"\<ARMA_MAPE\>\"", "->", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Abs", "[", 
                   RowBox[{"armaAvg", "-", "actAvg"}], "]"}], "/", "actAvg"}],
                  "*", "100.0"}]}], ",", "\[IndentingNewLine]", "      ", 
               RowBox[{"\"\<Kalman_MAPE\>\"", "->", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Abs", "[", 
                   RowBox[{"kalmanAvg", "-", "actAvg"}], "]"}], "/", 
                  "actAvg"}], "*", "100.0"}]}], ",", "\[IndentingNewLine]", 
               "      ", 
               RowBox[{"\"\<Naive_MAPE\>\"", "->", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Abs", "[", 
                   RowBox[{"naiveAvg", "-", "actAvg"}], "]"}], "/", 
                  "actAvg"}], "*", "100.0"}]}]}], "\[IndentingNewLine]", 
              "    ", "|>"}]}], "]"}], ";"}], "\[IndentingNewLine]", "  ", ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", 
            RowBox[{
            "nTotal", "-", "windowLookback", "-", "evalHorizon", "+", "1"}], ",",
             "stepSize"}], "}"}]}], "]"}], ";", "\[IndentingNewLine]", "  ", 
        "results"}]}], "\[IndentingNewLine]", "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Completed Walk-Forward Backtest across \>\"", ",", 
      RowBox[{"Length", "[", "rollingResults", "]"}], 
      ",", "\"\< evaluation windows.\>\""}], "]"}], ";"}]}]}]], "Input",
 CellLabel->"In[80]:=",ExpressionUUID->"32311033-50d3-440f-897a-a5bc8b0394cc"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"Completed Walk-Forward Backtest across \"\>", "\[InvisibleSpace]",
    "16", "\[InvisibleSpace]", "\<\" evaluation windows.\"\>"}],
  SequenceForm[
  "Completed Walk-Forward Backtest across ", 16, " evaluation windows."],
  Editable->False]], "Print",
 CellChangeTimes->{4.0025014685222473`*^9},
 CellLabel->
  "During evaluation of \
In[80]:=",ExpressionUUID->"0765813e-9fe7-4fc6-8675-71209979f7b3"]
}, Open  ]],

Cell["\<\
We now compute aggregate statistics across all 16 evaluation windows: \
\>", "CodeText",ExpressionUUID->"941738c8-ee38-4ac9-8845-7071670af0ef"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Aggregate", " ", "Statistical", " ", "Comparison", " ", "across", " ", 
    "all", " ", "16", " ", "Windows"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"meanArmaMAPE", "=", 
     RowBox[{"Mean", "[", 
      RowBox[{"rollingResults", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "\"\<ARMA_MAPE\>\""}], "]"}], "]"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"meanKalmanMAPE", "=", 
     RowBox[{"Mean", "[", 
      RowBox[{"rollingResults", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "\"\<Kalman_MAPE\>\""}], "]"}], "]"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"meanNaiveMAPE", "=", 
     RowBox[{"Mean", "[", 
      RowBox[{"rollingResults", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "\"\<Naive_MAPE\>\""}], "]"}], "]"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"medArmaMAPE", "=", 
     RowBox[{"Median", "[", 
      RowBox[{"rollingResults", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "\"\<ARMA_MAPE\>\""}], "]"}], "]"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"medKalmanMAPE", "=", 
     RowBox[{"Median", "[", 
      RowBox[{"rollingResults", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "\"\<Kalman_MAPE\>\""}], "]"}], "]"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"medNaiveMAPE", "=", 
     RowBox[{"Median", "[", 
      RowBox[{"rollingResults", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "\"\<Naive_MAPE\>\""}], "]"}], "]"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
