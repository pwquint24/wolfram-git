  "During evaluation of \
In[1]:=",ExpressionUUID->"ae0b3e87-951f-492e-9113-6bbb241ebd24"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"Successfully loaded \"\>", "\[InvisibleSpace]", "502", 
   "\[InvisibleSpace]", "\<\" trading days from \"\>", 
   "\[InvisibleSpace]", "\<\"January 2023\"\>", 
   "\[InvisibleSpace]", "\<\" to \"\>", 
   "\[InvisibleSpace]", "\<\"December 2024\"\>", 
   "\[InvisibleSpace]", "\<\".\"\>"}],
  SequenceForm[
  "Successfully loaded ", 502, " trading days from ", "January 2023", " to ", 
   "December 2024", "."],
  Editable->False]], "Print",
 CellChangeTimes->{4.002501463584586*^9},
