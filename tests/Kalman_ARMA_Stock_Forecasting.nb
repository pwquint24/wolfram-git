      RowBox[{"AxesLabel", "->", 
       RowBox[{"{", 
        RowBox[{"\"\<Relative Trading Day\>\"", ",", "\"\<Price ($)\>\""}], 
        "}"}]}], ",", "\[IndentingNewLine]", "  ", 
