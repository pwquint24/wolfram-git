Cell["\<\
Using the fitted ARMA model, we generate multi-step return forecasts and \
reconstruct the price trajectory: \
\>", "CodeText",ExpressionUUID->"aebd42fe-50bf-416a-909c-49e292b44ff2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Multi", "-", 
    RowBox[{
    "step", " ", "forward", " ", "forecasting", " ", "of", " ", "returns"}]}],
    " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"forecastReturns", "=", 
     RowBox[{"Normal", "[", 
      RowBox[{
       RowBox[{"TimeSeriesForecast", "[", 
        RowBox[{"tsmARMA", ",", 
         RowBox[{"{", "horizon", "}"}]}], "]"}], "[", "\"\<Values\>\"", "]"}],
       "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Reconstruct", " ", "expected", " ", "price", " ", "path", " ", "from", " ",
      "cumulative", " ", "forecasted", " ", "returns"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"pLast", "=", 
     RowBox[{"Last", "[", "trainPrices", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"armaPricePath", "=", 
     RowBox[{"pLast", "*", 
      RowBox[{"Exp", "[", 
       RowBox[{"Accumulate", "[", "forecastReturns", "]"}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "Compute", " ", "expected", " ", "average", " ", "future", " ", "price", 
      " ", "over", " ", "the", " ", "20"}], "-", 
     RowBox[{"day", " ", "horizon"}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"armaAvgPrice", "=", 
     RowBox[{"Mean", "[", "armaPricePath", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<ARMA Expected Average Future Price: $\>\"", ",", 
      RowBox[{"NumberForm", "[", 
       RowBox[{"armaAvgPrice", ",", 
        RowBox[{"{", 
         RowBox[{"6", ",", "2"}], "}"}]}], "]"}]}], "]"}], ";"}]}]}]], "Input",\

 CellLabel->"In[38]:=",ExpressionUUID->"cc4aeb52-b7ac-49d9-ade5-346afb068009"],

