Cell[CellGroupData[{

Cell["4. Kalman Filtering for Dynamic Trend Extraction", "Section",ExpressionUUID->"28a18998-c91f-42d9-862d-4c14062f42ae"],

Cell[TextData[{
 "We implement a 2D Local Linear Trend Kalman Filter in Wolfram Language. The \
state vector x",
 StyleBox["t = [mu",
  FontSlant->Italic],
 "t, beta_t]^T represents the true unobserved price trend level and its \
dynamic velocity (slope in $/day). The filter performs recursive Bayesian \
prediction and measurement updates, eliminating the phase lag inherent in \
standard moving averages. "
}], "Text",ExpressionUUID->"f1adba12-6c0b-4e8c-b12f-788412ea05c7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Pure", " ", "Wolfram", " ", "Language", " ", "Implementation", " ", "of", 
    " ", "Local", " ", "Linear", " ", "Trend", " ", "Kalman", " ", "Filter"}],
    " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"kalmanTrendFilter", "[", 
     RowBox[{"data_List", ",", 
      RowBox[{"qLevel_", "?", "NumericQ"}], ",", 
      RowBox[{"qSlope_", "?", "NumericQ"}], ",", 
      RowBox[{"rNoise_", "?", "NumericQ"}]}], "]"}], ":=", 
    "\[IndentingNewLine]", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"n", "=", 
         RowBox[{"Length", "[", "data", "]"}]}], ",", "mu", ",", "beta", ",", 
        "p11", ",", "p12", ",", "p22", ",", "k1", ",", "k2", ",", "y", ",", 
        "v", ",", "f", ",", "\[IndentingNewLine]", "         ", "filteredMu", 
        ",", "filteredBeta"}], "}"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"(*", " ", 
       RowBox[{
       "Initialize", " ", "state", " ", "with", " ", "first", " ", "observed",
         " ", "price", " ", "and", " ", "zero", " ", "slope"}], " ", "*)"}], 
      "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"mu", "=", 
        RowBox[{"data", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", "  ", 
       RowBox[{"beta", "=", "0.0"}], ";", "\[IndentingNewLine]", "  ", 
       RowBox[{"(*", " ", 
        RowBox[{
        "Initial", " ", "state", " ", "uncertainty", " ", "covariance"}], " ",
         "*)"}], "\[IndentingNewLine]", "  ", 
       RowBox[{"p11", "=", "1000.0"}], ";", " ", 
       RowBox[{"p12", "=", "0.0"}], ";", " ", 
       RowBox[{"p22", "=", "100.0"}], ";", "\[IndentingNewLine]", "  ", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"filteredMu", "=", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{"0.0", ",", "n"}], "]"}]}], ";", "\[IndentingNewLine]", "  ", 
       RowBox[{"filteredBeta", "=", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{"0.0", ",", "n"}], "]"}]}], ";", "\[IndentingNewLine]", "  ",
        "\[IndentingNewLine]", "  ", 
       RowBox[{"Do", "[", "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{
          RowBox[{"y", "=", 
           RowBox[{"data", "[", 
            RowBox[{"[", "t", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          "    ", "\[IndentingNewLine]", "    ", 
          RowBox[{"(*", " ", 
           RowBox[{"1.", " ", "Predict", " ", "Step"}], " ", "*)"}], 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"mu", "=", 
           RowBox[{"mu", "+", "beta"}]}], ";", "\[IndentingNewLine]", "    ", 
          
          RowBox[{"p11", "=", 
           RowBox[{"p11", "+", 
            RowBox[{"2.0", "*", "p12"}], "+", "p22", "+", "qLevel"}]}], ";", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"p12", "=", 
           RowBox[{"p12", "+", "p22"}]}], ";", "\[IndentingNewLine]", "    ", 
          
          RowBox[{"p22", "=", 
           RowBox[{"p22", "+", "qSlope"}]}], ";", "\[IndentingNewLine]", 
          "    ", "\[IndentingNewLine]", "    ", 
          RowBox[{"(*", " ", 
           RowBox[{"2.", " ", "Measurement", " ", "Update", " ", "Step"}], 
           " ", "*)"}], "\[IndentingNewLine]", "    ", 
          RowBox[{"v", "=", 
           RowBox[{"y", "-", "mu"}]}], ";", "           ", 
          RowBox[{"(*", " ", 
           RowBox[{"Innovation", " ", "residual"}], " ", "*)"}], 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"f", "=", 
           RowBox[{"p11", "+", "rNoise"}]}], ";", "     ", 
          RowBox[{"(*", " ", 
           RowBox[{"Innovation", " ", "variance"}], " ", "*)"}], 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"k1", "=", 
           RowBox[{"p11", "/", "f"}]}], ";", "         ", 
          RowBox[{"(*", " ", 
           RowBox[{"Kalman", " ", "gain", " ", "for", " ", "level"}], " ", 
           "*)"}], "\[IndentingNewLine]", "    ", 
          RowBox[{"k2", "=", 
           RowBox[{"p12", "/", "f"}]}], ";", "         ", 
          RowBox[{"(*", " ", 
           RowBox[{"Kalman", " ", "gain", " ", "for", " ", "slope"}], " ", 
           "*)"}], "\[IndentingNewLine]", "    ", "\[IndentingNewLine]", 
          "    ", 
          RowBox[{"mu", "=", 
           RowBox[{"mu", "+", 
            RowBox[{"k1", "*", "v"}]}]}], ";", "\[IndentingNewLine]", "    ", 
          
          RowBox[{"beta", "=", 
           RowBox[{"beta", "+", 
            RowBox[{"k2", "*", "v"}]}]}], ";", "\[IndentingNewLine]", "    ", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"(*", " ", 
           RowBox[{"Covariance", " ", "update"}], " ", "*)"}], 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"p22", "=", 
           RowBox[{"p22", "-", 
            RowBox[{"k2", "*", "p12"}]}]}], ";", "\[IndentingNewLine]", 
          "    ", 
          RowBox[{"p12", "=", 
           RowBox[{"p12", "-", 
            RowBox[{"k1", "*", "p12"}]}]}], ";", "\[IndentingNewLine]", 
          "    ", 
          RowBox[{"p11", "=", 
           RowBox[{"p11", "-", 
            RowBox[{"k1", "*", "p11"}]}]}], ";", "\[IndentingNewLine]", 
          "    ", "\[IndentingNewLine]", "    ", 
          RowBox[{
           RowBox[{"filteredMu", "[", 
            RowBox[{"[", "t", "]"}], "]"}], "=", "mu"}], ";", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{
           RowBox[{"filteredBeta", "[", 
            RowBox[{"[", "t", "]"}], "]"}], "=", "beta"}], ";"}], 
         "\[IndentingNewLine]", "  ", ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", "1", ",", "n"}], "}"}]}], "]"}], ";", 
       "\[IndentingNewLine]", "  ", "\[IndentingNewLine]", "  ", 
       RowBox[{"<|", "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{"\"\<Trend\>\"", "->", "filteredMu"}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"\"\<Slope\>\"", "->", "filteredBeta"}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"\"\<FinalState\>\"", "->", 
          RowBox[{"{", 
           RowBox[{"mu", ",", "beta"}], "}"}]}], ",", "\[IndentingNewLine]", 
         "    ", 
         RowBox[{"\"\<FinalCov\>\"", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"p11", ",", "p12"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"p12", ",", "p22"}], "}"}]}], "}"}]}]}], 
        "\[IndentingNewLine]", "  ", "|>"}]}]}], "\[IndentingNewLine]", " ", 
     "]"}]}], ";"}]}]], "Input",
 CellLabel->"In[43]:=",ExpressionUUID->"5acb7fee-0eab-4834-8c00-1acc62b890e6"],

Cell["We now run the filter on the in-sample stock prices: ", "CodeText",ExpressionUUID->"5d54b4d7-e325-41a6-8e2a-05d907aeec24"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Filter", " ", "in"}], "-", 
    RowBox[{
    "sample", " ", "training", " ", "prices", " ", "with", " ", "Local", " ", 
     "Linear", " ", "Trend", " ", "Kalman", " ", "Filter"}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Parameters", ":", " ", "qLevel"}], " ", "=", " ", "1.0"}], ",", 
    " ", 
    RowBox[{"qSlope", " ", "=", " ", "0.05"}], ",", " ", 
    RowBox[{"rNoise", " ", "=", " ", "5.0"}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"kfResults", "=", 
     RowBox[{"kalmanTrendFilter", "[", 
      RowBox[{"trainPrices", ",", "1.0", ",", "0.05", ",", "5.0"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"trendPath", "=", 
     RowBox[{"kfResults", "[", "\"\<Trend\>\"", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"slopePath", "=", 
     RowBox[{"kfResults", "[", "\"\<Slope\>\"", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"finalState", "=", 
     RowBox[{"kfResults", "[", "\"\<FinalState\>\"", "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Terminal Kalman Filter State:\>\"", "]"}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<  Extracted Trend Level (mu): $\>\"", ",", 
      RowBox[{"NumberForm", "[", 
       RowBox[{
        RowBox[{"finalState", "[", 
         RowBox[{"[", "1", "]"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"6", ",", "2"}], "}"}]}], "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<  Extracted Trend Velocity (beta): $\>\"", ",", 
      RowBox[{"NumberForm", "[", 
       RowBox[{
        RowBox[{"finalState", "[", 
         RowBox[{"[", "2", "]"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"4", ",", "2"}], "}"}]}], "]"}], 
      ",", "\"\< per trading day\>\""}], "]"}], ";"}]}]}]], "Input",
 CellLabel->"In[44]:=",ExpressionUUID->"dea4401a-7c42-4a75-aab5-3a5bdbe5e52f"],

