Cell[CellGroupData[{

Cell["5. Out-of-Sample Performance Comparison (Single Window)", "Section",ExpressionUUID->"c3df60bc-395a-4771-8721-fd5fb9d6e2f2"],

Cell["\<\
We compare the ARMA and Kalman Filter forecasts against the actual realized \
out-of-sample stock prices over the 20-day test horizon. We also include the \
Naive Random Walk Benchmark (where future expected price equals the last \
observed price P_T). \
\>", "Text",ExpressionUUID->"c5bc23bb-4c4c-47bb-b109-d0ebfc79aaa0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Compute", " ", "realized", " ", "metrics", " ", "and", " ", "benchmark"}],
    " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"actualAvgPrice", "=", 
     RowBox[{"Mean", "[", "testPrices", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"naiveAvgPrice", "=", "pLast"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"naivePricePath", "=", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"pLast", ",", "horizon"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Percentage", " ", "errors", " ", "on", " ", "the", " ", "expected", " ", 
     "average", " ", "price"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"armaAvgErrPct", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{"armaAvgPrice", "-", "actualAvgPrice"}], "]"}], "/", 
       "actualAvgPrice"}], "*", "100.0"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"kalmanAvgErrPct", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{"kalmanAvgPrice", "-", "actualAvgPrice"}], "]"}], "/", 
       "actualAvgPrice"}], "*", "100.0"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"naiveAvgErrPct", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{"naiveAvgPrice", "-", "actualAvgPrice"}], "]"}], "/", 
       "actualAvgPrice"}], "*", "100.0"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Path", "-", 
     RowBox[{"wise", " ", "Mean", " ", "Absolute", " ", "Error", " ", 
      RowBox[{"(", "MAE", ")"}], " ", "and", " ", "Root", " ", "Mean", " ", 
      "Squared", " ", "Error", " ", 
      RowBox[{"(", "RMSE", ")"}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"calcMAE", "[", 
      RowBox[{"act_", ",", "pred_"}], "]"}], ":=", 
     RowBox[{"Mean", "[", 
      RowBox[{"Abs", "[", 
       RowBox[{"act", "-", "pred"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"calcRMSE", "[", 
      RowBox[{"act_", ",", "pred_"}], "]"}], ":=", 
     RowBox[{"Sqrt", "[", 
      RowBox[{"Mean", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"act", "-", "pred"}], ")"}], "^", "2"}], "]"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"armaMAE", "=", 
     RowBox[{"calcMAE", "[", 
      RowBox[{"testPrices", ",", "armaPricePath"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"kalmanMAE", "=", 
     RowBox[{"calcMAE", "[", 
      RowBox[{"testPrices", ",", "kalmanPricePath"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"naiveMAE", "=", 
     RowBox[{"calcMAE", "[", 
      RowBox[{"testPrices", ",", "naivePricePath"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"armaRMSE", "=", 
     RowBox[{"calcRMSE", "[", 
      RowBox[{"testPrices", ",", "armaPricePath"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"kalmanRMSE", "=", 
     RowBox[{"calcRMSE", "[", 
      RowBox[{"testPrices", ",", "kalmanPricePath"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"naiveRMSE", "=", 
     RowBox[{"calcRMSE", "[", 
      RowBox[{"testPrices", ",", "naivePricePath"}], "]"}]}], 
    ";"}]}]}]], "Input",
 CellLabel->"In[60]:=",ExpressionUUID->"a96bf2ec-6dca-42bf-9100-58951991f847"],

Cell["We format and display the comparison table: ", "CodeText",ExpressionUUID->"2c2a4866-9984-42c0-a970-68bec47ea11d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Display", " ", "Performance", " ", "Comparison", " ", "Table"}], 
   " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"Grid", "[", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\"\<Metric\>\"", ",", "\"\<Actual Realized\>\"", 
        ",", "\"\<ARMA Model\>\"", ",", "\"\<Kalman Trend Filter\>\"", 
        ",", "\"\<Naive (Random Walk)\>\""}], "}"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"{", 
       RowBox[{"\"\<Expected Average Price ($)\>\"", ",", 
        "\[IndentingNewLine]", "   ", 
        RowBox[{"NumberForm", "[", 
         RowBox[{"actualAvgPrice", ",", 
          RowBox[{"{", 
           RowBox[{"6", ",", "2"}], "}"}]}], "]"}], ",", 
        "\[IndentingNewLine]", "   ", 
        RowBox[{"NumberForm", "[", 
         RowBox[{"armaAvgPrice", ",", 
          RowBox[{"{", 
           RowBox[{"6", ",", "2"}], "}"}]}], "]"}], ",", 
        "\[IndentingNewLine]", "   ", 
        RowBox[{"NumberForm", "[", 
         RowBox[{"kalmanAvgPrice", ",", 
          RowBox[{"{", 
           RowBox[{"6", ",", "2"}], "}"}]}], "]"}], ",", 
        "\[IndentingNewLine]", "   ", 
        RowBox[{"NumberForm", "[", 
         RowBox[{"naiveAvgPrice", ",", 
          RowBox[{"{", 
           RowBox[{"6", ",", "2"}], "}"}]}], "]"}]}], "}"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"{", 
       RowBox[{"\"\<Average Price Error ($)\>\"", ",", "\[IndentingNewLine]", 
        "   ", "\"\<$0.00\>\"", ",", "\[IndentingNewLine]", "   ", 
        RowBox[{"NumberForm", "[", 
         RowBox[{
          RowBox[{"armaAvgPrice", "-", "actualAvgPrice"}], ",", 
          RowBox[{"{", 
           RowBox[{"4", ",", "2"}], "}"}]}], "]"}], ",", 
        "\[IndentingNewLine]", "   ", 
        RowBox[{"NumberForm", "[", 
         RowBox[{
          RowBox[{"kalmanAvgPrice", "-", "actualAvgPrice"}], ",", 
          RowBox[{"{", 
           RowBox[{"4", ",", "2"}], "}"}]}], "]"}], ",", 
        "\[IndentingNewLine]", "   ", 
        RowBox[{"NumberForm", "[", 
         RowBox[{
          RowBox[{"naiveAvgPrice", "-", "actualAvgPrice"}], ",", 
          RowBox[{"{", 
           RowBox[{"4", ",", "2"}], "}"}]}], "]"}]}], "}"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"{", 
       RowBox[{"\"\<Absolute Error (%)\>\"", ",", "\[IndentingNewLine]", 
        "   ", "\"\<0.00%\>\"", ",", "\[IndentingNewLine]", "   ", 
        RowBox[{
         RowBox[{"NumberForm", "[", 
          RowBox[{"armaAvgErrPct", ",", 
           RowBox[{"{", 
            RowBox[{"4", ",", "2"}], "}"}]}], "]"}], " ", "<>", 
         " ", "\"\<%\>\""}], ",", "\[IndentingNewLine]", "   ", 
        RowBox[{
         RowBox[{"NumberForm", "[", 
          RowBox[{"kalmanAvgErrPct", ",", 
           RowBox[{"{", 
            RowBox[{"4", ",", "2"}], "}"}]}], "]"}], " ", "<>", 
         " ", "\"\<%\>\""}], ",", "\[IndentingNewLine]", "   ", 
        RowBox[{
         RowBox[{"NumberForm", "[", 
          RowBox[{"naiveAvgErrPct", ",", 
           RowBox[{"{", 
            RowBox[{"4", ",", "2"}], "}"}]}], "]"}], " ", "<>", 
         " ", "\"\<%\>\""}]}], "}"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"{", 
       RowBox[{"\"\<Path MAE ($)\>\"", ",", "\[IndentingNewLine]", 
        "   ", "\"\<-\>\"", ",", "\[IndentingNewLine]", "   ", 
        RowBox[{"NumberForm", "[", 
         RowBox[{"armaMAE", ",", 
          RowBox[{"{", 
           RowBox[{"4", ",", "2"}], "}"}]}], "]"}], ",", 
        "\[IndentingNewLine]", "   ", 
        RowBox[{"NumberForm", "[", 
         RowBox[{"kalmanMAE", ",", 
          RowBox[{"{", 
           RowBox[{"4", ",", "2"}], "}"}]}], "]"}], ",", 
        "\[IndentingNewLine]", "   ", 
        RowBox[{"NumberForm", "[", 
         RowBox[{"naiveMAE", ",", 
          RowBox[{"{", 
           RowBox[{"4", ",", "2"}], "}"}]}], "]"}]}], "}"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"{", 
       RowBox[{"\"\<Path RMSE ($)\>\"", ",", "\[IndentingNewLine]", 
        "   ", "\"\<-\>\"", ",", "\[IndentingNewLine]", "   ", 
        RowBox[{"NumberForm", "[", 
         RowBox[{"armaRMSE", ",", 
          RowBox[{"{", 
           RowBox[{"4", ",", "2"}], "}"}]}], "]"}], ",", 
        "\[IndentingNewLine]", "   ", 
        RowBox[{"NumberForm", "[", 
         RowBox[{"kalmanRMSE", ",", 
          RowBox[{"{", 
           RowBox[{"4", ",", "2"}], "}"}]}], "]"}], ",", 
        "\[IndentingNewLine]", "   ", 
