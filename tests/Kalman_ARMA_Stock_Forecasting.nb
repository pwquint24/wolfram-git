Cell["\<\
We visualize the window-by-window forecast error distribution using a grouped \
bar chart: \
\>", "CodeText",ExpressionUUID->"57bc02ec-8dc2-4c95-9aff-33e6f417c222"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Grouped", " ", "Bar", " ", "Chart", " ", "of", " ", "Prediction", " ", 
    "Error", " ", "Percentage", " ", "per", " ", "Window"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"windowLabels", "=", 
     RowBox[{"rollingResults", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "\"\<Window\>\""}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"armaErrors", "=", 
     RowBox[{"rollingResults", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "\"\<ARMA_MAPE\>\""}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"kalmanErrors", "=", 
     RowBox[{"rollingResults", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "\"\<Kalman_MAPE\>\""}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"naiveErrors", "=", 
     RowBox[{"rollingResults", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "\"\<Naive_MAPE\>\""}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"BarChart", "[", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"armaErrors", ",", "kalmanErrors", ",", "naiveErrors"}], "}"}],
       "]"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"ChartLayout", "->", "\"\<Grouped\>\""}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"ChartStyle", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"RGBColor", "[", 
         RowBox[{"0.85", ",", "0.25", ",", "0.25"}], "]"}], ",", 
        RowBox[{"RGBColor", "[", 
         RowBox[{"0.15", ",", "0.5", ",", "0.85"}], "]"}], ",", 
        RowBox[{"GrayLevel", "[", "0.65", "]"}]}], "}"}]}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"ChartLegends", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<ARMA Model\>\"", ",", "\"\<Kalman Trend\>\"", 
        ",", "\"\<Naive Benchmark\>\""}], "}"}]}], ",", "\[IndentingNewLine]",
      "  ", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<Rolling Window Number\>\"", 
        ",", "\"\<Absolute Error (%)\>\""}], "}"}]}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"PlotLabel", "->", 
      RowBox[{"Style", "[", 
       RowBox[{"\"\<Expected Average Price Forecast Error across 16 Test \
Windows\>\"", ",", "Bold", ",", "14"}], "]"}]}], ",", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{"GridLines", "->", 
      RowBox[{"{", 
       RowBox[{"None", ",", "Automatic"}], "}"}]}], ",", 
     RowBox[{"ImageSize", "->", "580"}]}], "]"}]}]}]], "Input",
 CellLabel->"In[97]:=",ExpressionUUID->"4966573a-ac30-4da7-9354-dbe6f94855a9"],

