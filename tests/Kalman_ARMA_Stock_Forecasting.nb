Cell["\<\
We now compute key summary statistics for the daily returns: \
\>", "CodeText",ExpressionUUID->"b1a550f9-de22-4116-b241-7cac304cebe9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Summary", " ", "statistics", " ", "for", " ", "log", " ", "returns"}], 
   " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"retMean", "=", 
     RowBox[{"Mean", "[", "logReturns", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"retStd", "=", 
     RowBox[{"StandardDeviation", "[", "logReturns", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"retSkew", "=", 
     RowBox[{"Skewness", "[", "logReturns", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"retKurt", "=", 
     RowBox[{"Kurtosis", "[", "logReturns", "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"Dataset", "[", 
    RowBox[{"<|", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"\"\<Sample Size (Days)\>\"", "->", 
       RowBox[{"Length", "[", "logReturns", "]"}]}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<Daily Mean Return\>\"", "->", 
       RowBox[{"NumberForm", "[", 
        RowBox[{"retMean", ",", 
         RowBox[{"{", 
          RowBox[{"6", ",", "5"}], "}"}]}], "]"}]}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<Annualized Return (x252)\>\"", "->", 
       RowBox[{
        RowBox[{"NumberForm", "[", 
         RowBox[{
          RowBox[{"retMean", "*", "252", "*", "100"}], ",", 
          RowBox[{"{", 
           RowBox[{"4", ",", "2"}], "}"}]}], "]"}], " ", "<>", 
        " ", "\"\<%\>\""}]}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<Daily Volatility\>\"", "->", 
       RowBox[{"NumberForm", "[", 
        RowBox[{"retStd", ",", 
         RowBox[{"{", 
          RowBox[{"6", ",", "5"}], "}"}]}], "]"}]}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<Annualized Volatility (xSqrt[252])\>\"", "->", 
       RowBox[{
        RowBox[{"NumberForm", "[", 
         RowBox[{
          RowBox[{"retStd", "*", 
           RowBox[{"Sqrt", "[", "252", "]"}], "*", "100"}], ",", 
          RowBox[{"{", 
           RowBox[{"4", ",", "2"}], "}"}]}], "]"}], " ", "<>", 
        " ", "\"\<%\>\""}]}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<Skewness\>\"", "->", 
       RowBox[{"NumberForm", "[", 
        RowBox[{"retSkew", ",", 
         RowBox[{"{", 
          RowBox[{"4", ",", "2"}], "}"}]}], "]"}]}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<Kurtosis\>\"", "->", 
       RowBox[{"NumberForm", "[", 
        RowBox[{"retKurt", ",", 
         RowBox[{"{", 
          RowBox[{"4", ",", "2"}], "}"}]}], "]"}]}]}], "\[IndentingNewLine]", 
     "|>"}], "]"}]}]}]], "Input",
 CellLabel->"In[16]:=",ExpressionUUID->"7016368c-0d92-48ae-b3ad-7d64f59ade60"],

