Cell["\<\
To demonstrate the zero-lag characteristic of the Kalman filter, we compare \
it against a standard 20-day Simple Moving Average (SMA): \
\>", "CodeText",ExpressionUUID->"c824c32c-b71c-49e5-bce2-c64e9e74ef81"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Calculate", " ", "standard", " ", "20"}], "-", 
    RowBox[{"day", " ", "Simple", " ", "Moving", " ", "Average", " ", 
     RowBox[{"(", "SMA", ")"}], " ", "for", " ", "benchmark"}]}], " ", "*)"}],
   "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"sma20", "=", 
     RowBox[{"MovingAverage", "[", 
      RowBox[{"trainPrices", ",", "20"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Plot", ":", " ", 
     RowBox[{
      RowBox[{"Price", " ", 
       RowBox[{"vs", ".", " ", "Kalman"}], " ", "Trend", " ", 
       RowBox[{"vs", ".", " ", "20"}]}], "-", 
      RowBox[{"day", " ", "SMA"}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"pCompare", "=", 
     RowBox[{"ListLinePlot", "[", 
      RowBox[{
       RowBox[{"{", "\[IndentingNewLine]", "    ", 
        RowBox[{
        "trainPrices", ",", "\[IndentingNewLine]", "    ", "trendPath", ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"PadLeft", "[", 
          RowBox[{"sma20", ",", 
           RowBox[{"Length", "[", "trainPrices", "]"}], ",", "Null"}], 
          "]"}]}], "\[IndentingNewLine]", "  ", "}"}], ",", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"{", "\[IndentingNewLine]", "    ", 
         RowBox[{
          RowBox[{"Directive", "[", 
           RowBox[{"Thin", ",", 
            RowBox[{"GrayLevel", "[", "0.7", "]"}]}], "]"}], ",", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"Directive", "[", 
           RowBox[{"Thick", ",", 
            RowBox[{"RGBColor", "[", 
             RowBox[{"0.1", ",", "0.4", ",", "0.85"}], "]"}]}], "]"}], ",", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"Directive", "[", 
           RowBox[{"Dashed", ",", "Thick", ",", 
            RowBox[{"RGBColor", "[", 
             RowBox[{"0.85", ",", "0.45", ",", "0.1"}], "]"}]}], "]"}]}], 
         "\[IndentingNewLine]", "  ", "}"}]}], ",", "\[IndentingNewLine]", 
       "  ", 
       RowBox[{"PlotLegends", "->", 
        RowBox[{"Placed", "[", 
         RowBox[{
          RowBox[{"{", 
           
           RowBox[{"\"\<Daily Close\>\"", ",", "\"\<Kalman Trend (Level)\>\"",
             ",", "\"\<20-day SMA\>\""}], "}"}], ",", "Below"}], "]"}]}], ",",
        "\[IndentingNewLine]", "  ", 
       RowBox[{"PlotLabel", "->", 
        RowBox[{"Style", "[", 
         RowBox[{"\"\<In-Sample Trend Extraction: Kalman Filter vs. 20-day \
SMA\>\"", ",", "Bold", ",", "14"}], "]"}]}], ",", "\[IndentingNewLine]", "  ", 
       RowBox[{"AxesLabel", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<Trading Day\>\"", ",", "\"\<Price ($)\>\""}], "}"}]}], ",",
        "\[IndentingNewLine]", "  ", 
       RowBox[{"GridLines", "->", "Automatic"}], ",", 
       RowBox[{"ImageSize", "->", "550"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"pSlope", "=", 
     RowBox[{"ListLinePlot", "[", 
      RowBox[{"slopePath", ",", "\[IndentingNewLine]", "  ", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"Directive", "[", 
         RowBox[{"Thick", ",", 
          RowBox[{"RGBColor", "[", 
           RowBox[{"0.2", ",", "0.65", ",", "0.3"}], "]"}]}], "]"}]}], ",", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"PlotLabel", "->", 
        RowBox[{"Style", "[", 
         RowBox[{"\"\<Kalman Dynamic Trend Velocity (Slope: $/day)\>\"", ",", 
          "Bold", ",", "14"}], "]"}]}], ",", "\[IndentingNewLine]", "  ", 
       RowBox[{"AxesLabel", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<Trading Day\>\"", ",", "\"\<Slope ($/day)\>\""}], 
         "}"}]}], ",", "\[IndentingNewLine]", "  ", 
       RowBox[{"Filling", "->", "Axis"}], ",", 
       RowBox[{"GridLines", "->", "Automatic"}], ",", 
       RowBox[{"ImageSize", "->", "550"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
