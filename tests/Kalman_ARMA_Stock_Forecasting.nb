Cell[CellGroupData[{

Cell["3. ARMA Model Estimation on Returns", "Section",ExpressionUUID->"f3c69f9a-6572-48be-9368-2f33ba693f8f"],

Cell["\<\
We partition the dataset into an in-sample training window (450 trading days) \
and an out-of-sample evaluation window (20 trading days, ~1 calendar month). \
We fit an ARMA process to stationary returns and forecast the future \
trajectory. \
\>", "Text",ExpressionUUID->"afb86ff0-513e-4e98-9fd2-4644889c63a6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Split", " ", "data", " ", "into", " ", "In"}], "-", 
    RowBox[{"Sample", " ", "Training", " ", "and", " ", "Out"}], "-", "of", "-", 
    RowBox[{"Sample", " ", "Testing", " ", "sets"}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"nTrain", "=", "450"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"horizon", "=", "20"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"trainPrices", "=", 
     RowBox[{"rawPrices", "[", 
      RowBox[{"[", 
       RowBox[{"1", " ", ";;", " ", "nTrain"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"testPrices", "=", 
     RowBox[{"rawPrices", "[", 
      RowBox[{"[", 
       RowBox[{
        RowBox[{"nTrain", "+", "1"}], " ", ";;", " ", 
        RowBox[{"nTrain", "+", "horizon"}]}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"trainDates", "=", 
     RowBox[{"tradingDates", "[", 
      RowBox[{"[", 
       RowBox[{"1", " ", ";;", " ", "nTrain"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"testDates", "=", 
     RowBox[{"tradingDates", "[", 
      RowBox[{"[", 
       RowBox[{
        RowBox[{"nTrain", "+", "1"}], " ", ";;", " ", 
        RowBox[{"nTrain", "+", "horizon"}]}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"trainLogReturns", "=", 
     RowBox[{"Differences", "[", 
      RowBox[{"Log", "[", "trainPrices", "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Training sample size: \>\"", ",", 
      RowBox[{"Length", "[", "trainPrices", "]"}], ",", "\"\< days.\>\""}], 
     "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Testing forecast horizon: \>\"", ",", "horizon", 
      ",", "\"\< days.\>\""}], "]"}], ";"}]}]}]], "Input",
 CellLabel->"In[21]:=",ExpressionUUID->"7ae4c74e-ed65-4002-b66c-3bdf07aad552"],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"Training sample size: \"\>", "\[InvisibleSpace]", "450", 
   "\[InvisibleSpace]", "\<\" days.\"\>"}],
  SequenceForm["Training sample size: ", 450, " days."],
  Editable->False]], "Print",
 CellChangeTimes->{4.002501467637187*^9},
 CellLabel->
  "During evaluation of \
In[21]:=",ExpressionUUID->"37f4f04a-61c2-427f-aeed-95cff50c8e59"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"Testing forecast horizon: \"\>", "\[InvisibleSpace]", "20", 
   "\[InvisibleSpace]", "\<\" days.\"\>"}],
  SequenceForm["Testing forecast horizon: ", 20, " days."],
  Editable->False]], "Print",
 CellChangeTimes->{4.00250146763765*^9},
 CellLabel->
  "During evaluation of \
In[21]:=",ExpressionUUID->"ca26b61e-8ef4-4a37-9e69-3d673d983de8"]
}, Open  ]]
}, Open  ]],

Cell["\<\
We now estimate the optimal ARMA model using TimeSeriesModelFit: \
\>", "CodeText",ExpressionUUID->"ed1a692f-d2a9-4b36-9731-a246a927757b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Fit", " ", "an", " ", "ARMA", " ", "model", " ", "to", " ", "stationary", 
    " ", "log", " ", "returns"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"tsmARMA", "=", 
     RowBox[{"TimeSeriesModelFit", "[", 
      RowBox[{"trainLogReturns", ",", "\"\<ARMA\>\""}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"fittedProcess", "=", 
     RowBox[{"tsmARMA", "[", "\"\<Process\>\"", "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Fitted ARMA Process:\>\"", "]"}], ";"}], "\[IndentingNewLine]",
    "fittedProcess"}]}]], "Input",
 CellLabel->"In[30]:=",ExpressionUUID->"710739d3-7887-40ef-85c4-40365efbae91"],

Cell[BoxData["\<\"Fitted ARMA Process:\"\>"], "Print",
 CellChangeTimes->{4.002501467768919*^9},
 CellLabel->
  "During evaluation of \
In[30]:=",ExpressionUUID->"4d361d90-9ba6-406b-bb5f-1e35148562e4"],

Cell[BoxData[
 RowBox[{"MAProcess", "[", 
  RowBox[{"0.000945788231849463`", ",", 
   RowBox[{"{", "}"}], ",", "0.00006587201321171389`"}], "]"}]], "Output",
 CellChangeTimes->{4.002501467769493*^9},
 CellLabel->"Out[33]=",ExpressionUUID->"159fdabf-72cf-4380-8cba-36d45e74455c"]
}, Open  ]],

Cell["We verify the model fit using residual diagnostics: ", "CodeText",ExpressionUUID->"12535f41-34ce-4322-9961-613d0b207aea"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"ARMA", " ", "Model", " ", "Diagnostics"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"residuals", "=", 
     RowBox[{"Normal", "[", 
      RowBox[{
       RowBox[{"tsmARMA", "[", "\"\<FitResiduals\>\"", "]"}], 
       "[", "\"\<Values\>\"", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"pACF", "=", 
     RowBox[{"ListPlot", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"lag", ",", 
           RowBox[{"Correlation", "[", 
            RowBox[{
             RowBox[{"trainLogReturns", "[", 
              RowBox[{"[", 
               RowBox[{"1", " ", ";;", " ", 
                RowBox[{
                 RowBox[{"-", "lag"}], "-", "1"}]}], "]"}], "]"}], ",", 
             RowBox[{"trainLogReturns", "[", 
              RowBox[{"[", 
               RowBox[{
                RowBox[{"lag", "+", "1"}], " ", ";;", " ", 
                RowBox[{"-", "1"}]}], "]"}], "]"}]}], "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"lag", ",", "1", ",", "20"}], "}"}]}], "]"}], ",", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"Filling", "->", "Axis"}], ",", 
       RowBox[{"PlotRange", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "0.2"}], ",", "0.2"}], "}"}]}], ",", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"PlotLabel", "->", "\"\<Autocorrelation of Returns\>\""}], ",", 
       RowBox[{"AxesLabel", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<Lag\>\"", ",", "\"\<ACF\>\""}], "}"}]}], ",", 
       RowBox[{"ImageSize", "->", "300"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"pResHist", "=", 
     RowBox[{"Histogram", "[", 
      RowBox[{
      "residuals", ",", "30", ",", "\"\<PDF\>\"", ",", "\[IndentingNewLine]", 
       "  ", 
       RowBox[{"PlotLabel", "->", "\"\<Residual Distribution\>\""}], ",", 
       RowBox[{"ChartStyle", "->", 
        RowBox[{"RGBColor", "[", 
         RowBox[{"0.2", ",", "0.6", ",", "0.8"}], "]"}]}], ",", 
       RowBox[{"ImageSize", "->", "300"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"GraphicsRow", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"pACF", ",", "pResHist"}], "}"}], ",", 
     RowBox[{"ImageSize", "->", "600"}]}], "]"}]}]}]], "Input",
 CellLabel->"In[34]:=",ExpressionUUID->"56e83611-32fb-48ec-9561-86c92e0ec543"],

