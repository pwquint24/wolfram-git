Cell["\<\
We visualize the forecast paths alongside actual realized prices and dashed \
mean lines: \
\>", "CodeText",ExpressionUUID->"1aae858a-8d01-40e4-a867-e7fcba3783b2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Visualization", " ", "of", " ", "Out"}], "-", "of", "-", 
    RowBox[{"Sample", " ", "Forecasts", " ", 
     RowBox[{"vs", ".", " ", "Actual"}], " ", "Price", " ", "Trajectory"}]}], 
   " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"recentLookback", "=", "40"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"historySegment", "=", 
     RowBox[{"trainPrices", "[", 
      RowBox[{"[", 
       RowBox[{
        RowBox[{"-", "recentLookback"}], " ", ";;", " ", 
        RowBox[{"-", "1"}]}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"historyX", "=", 
     RowBox[{"Range", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "recentLookback"}], "+", "1"}], ",", "0"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"forecastX", "=", 
     RowBox[{"Range", "[", 
      RowBox[{"1", ",", "horizon"}], "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"pForecast", "=", 
    RowBox[{"Show", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"Recent", " ", "In"}], "-", 
       RowBox[{"Sample", " ", "History"}]}], " ", "*)"}], 
     "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"ListLinePlot", "[", 
       RowBox[{
        RowBox[{"Transpose", "[", 
         RowBox[{"{", 
          RowBox[{"historyX", ",", "historySegment"}], "}"}], "]"}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"PlotStyle", "->", 
         RowBox[{"Directive", "[", 
          RowBox[{"Thick", ",", 
           RowBox[{"GrayLevel", "[", "0.4", "]"}]}], "]"}]}]}], "]"}], ",", 
      "\[IndentingNewLine]", "  ", "\[IndentingNewLine]", "  ", 
      RowBox[{"(*", " ", 
       RowBox[{"Actual", " ", "Realized", " ", "Future", " ", "Prices"}], " ",
        "*)"}], "\[IndentingNewLine]", "  ", 
      RowBox[{"ListLinePlot", "[", 
