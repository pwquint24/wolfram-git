             RowBox[{"RGBColor", "[", 
              RowBox[{"0.85", ",", "0.2", ",", "0.2"}], "]"}], ",", 
             RowBox[{"RGBColor", "[", 
              RowBox[{"0.1", ",", "0.45", ",", "0.85"}], "]"}], ",", 
             RowBox[{"GrayLevel", "[", "0.6", "]"}]}], "}"}], ",", 
           "\[IndentingNewLine]", "      ", 
           RowBox[{"{", 
            
            RowBox[{"\"\<Recent History\>\"", ",", "\"\<Actual Realized\>\"", 
             ",", "\"\<ARMA Forecast\>\"", 
             ",", "\"\<Kalman Trend Forecast\>\"", 
             ",", "\"\<Naive Benchmark\>\""}], "}"}]}], "]"}], ",", 
         "\[IndentingNewLine]", "    ", "Below"}], "]"}]}]}], 
