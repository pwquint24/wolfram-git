Cell["\<\
We now extrapolate the Kalman trend forward into the test period: \
\>", "CodeText",ExpressionUUID->"9634688d-89f8-41db-8547-846283e9b8e0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Forward", " ", "price", " ", "path", " ", "extrapolation", " ", "from", " ",
     "terminal", " ", "Kalman", " ", "state"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"mu0", "=", 
     RowBox[{"finalState", "[", 
      RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"beta0", "=", 
     RowBox[{"finalState", "[", 
      RowBox[{"[", "2", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"kalmanPricePath", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"mu0", "+", 
        RowBox[{"k", "*", "beta0"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", "1", ",", "horizon"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Analytical", " ", "expected", " ", "average", " ", "future", " ", 
     "price", " ", "over", " ", "horizon", " ", "H"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"kalmanAvgPrice", "=", 
     RowBox[{"mu0", "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"horizon", "+", "1"}], ")"}], "/", "2.0"}], ")"}], "*", 
       "beta0"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Kalman Expected Average Future Price: $\>\"", ",", 
      RowBox[{"NumberForm", "[", 
       RowBox[{"kalmanAvgPrice", ",", 
        RowBox[{"{", 
         RowBox[{"6", ",", "2"}], "}"}]}], "]"}]}], "]"}], ";"}]}]}]], "Input",\

 CellLabel->"In[55]:=",ExpressionUUID->"a9593b81-0cee-44bc-8883-140b237bc13b"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"Kalman Expected Average Future Price: $\"\>", "\[InvisibleSpace]", 
   TagBox[
    InterpretationBox[
     StyleBox["\<\"594.88\"\>",
      ShowStringCharacters->False],
     594.8812316456044,
     AutoDelete->True],
    NumberForm[#, {6, 2}]& ]}],
  SequenceForm["Kalman Expected Average Future Price: $", 
   NumberForm[594.8812316456044, {6, 2}]],
  Editable->False]], "Print",
 CellChangeTimes->{4.002501468273431*^9},
 CellLabel->
