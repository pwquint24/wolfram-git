Cell["\<\
Next, we compute log returns and visualize the historical price trajectory \
alongside the daily return series. \
\>", "Text",ExpressionUUID->"602d944c-07fc-486f-9c25-126615a89534"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Compute", " ", "log", " ", "returns"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"logPrices", "=", 
     RowBox[{"Log", "[", "rawPrices", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"logReturns", "=", 
     RowBox[{"Differences", "[", "logPrices", "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Plot", " ", "historical", " ", "prices", " ", "and", " ", "daily", " ", 
     "returns"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"pPrice", "=", 
     RowBox[{"DateListPlot", "[", 
      RowBox[{"pricesTS", ",", "\[IndentingNewLine]", "  ", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"Directive", "[", 
         RowBox[{"Thick", ",", 
          RowBox[{"RGBColor", "[", 
           RowBox[{"0.1", ",", "0.4", ",", "0.7"}], "]"}]}], "]"}]}], ",", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"PlotLabel", "->", 
        RowBox[{"Style", "[", 
         RowBox[{
          RowBox[{
          "ticker", " ", "<>", 
           " ", "\"\< Daily Adjusted Close Price (2023 - 2024)\>\""}], ",", 
          "Bold", ",", "14"}], "]"}]}], ",", "\[IndentingNewLine]", "  ", 
       RowBox[{"FrameLabel", "->", 
        RowBox[{"{", 
         RowBox[{"None", ",", "\"\<Price ($)\>\""}], "}"}]}], ",", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"GridLines", "->", "Automatic"}], ",", 
       RowBox[{"ImageSize", "->", "550"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"pRet", "=", 
     RowBox[{"ListLinePlot", "[", 
      RowBox[{"logReturns", ",", "\[IndentingNewLine]", "  ", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"Directive", "[", 
         RowBox[{"RGBColor", "[", 
          RowBox[{"0.8", ",", "0.3", ",", "0.2"}], "]"}], "]"}]}], ",", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"PlotLabel", "->", 
        RowBox[{"Style", "[", 
         RowBox[{
          RowBox[{"ticker", " ", "<>", " ", "\"\< Daily Log Returns\>\""}], ",",
           "Bold", ",", "14"}], "]"}]}], ",", "\[IndentingNewLine]", "  ", 
       RowBox[{"AxesLabel", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<Trading Day\>\"", ",", "\"\<Log Return\>\""}], "}"}]}], 
       ",", "\[IndentingNewLine]", "  ", 
       RowBox[{"GridLines", "->", "Automatic"}], ",", 
       RowBox[{"ImageSize", "->", "550"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"GraphicsColumn", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"pPrice", ",", "pRet"}], "}"}], ",", 
     RowBox[{"ImageSize", "->", "550"}]}], "]"}]}]}]], "Input",
 CellLabel->"In[11]:=",ExpressionUUID->"6646e234-2299-4711-a211-9078d93eaca7"],

