}, Open  ]],

Cell[CellGroupData[{

Cell["2. Stock Data Acquisition and Preprocessing", "Section",ExpressionUUID->"68301c4f-1638-4d1b-ab53-e014932d2019"],

Cell["\<\
We acquire daily historical data for the S&P 500 ETF (SPY) using Wolfram \
Language's built-in FinancialData. We convert Quantity expressions to pure \
numeric values and compute continuously compounded log returns. \
\>", "Text",ExpressionUUID->"9d83de39-dcdf-4120-ae16-1741a75715b4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Define", " ", "stock", " ", "ticker", " ", "and", " ", "evaluation", " ", 
    "date", " ", "range"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ticker", "=", "\"\<SPY\>\""}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"startDate", "=", 
     RowBox[{"{", 
      RowBox[{"2023", ",", "1", ",", "1"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"endDate", "=", 
     RowBox[{"{", 
      RowBox[{"2024", ",", "12", ",", "31"}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Fetching historical daily data for \>\"", ",", "ticker", 
      ",", "\"\<...\>\""}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rawTS", "=", 
     RowBox[{"FinancialData", "[", 
      RowBox[{"ticker", ",", 
       RowBox[{"{", 
        RowBox[{"startDate", ",", "endDate"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Extract", " ", "pure", " ", "numeric", " ", "prices", " ", "and", " ", 
     "trading", " ", "dates"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"pricesTS", "=", 
     RowBox[{"QuantityMagnitude", "[", "rawTS", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tradingDates", "=", 
     RowBox[{"pricesTS", "[", "\"\<Dates\>\"", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rawPrices", "=", 
     RowBox[{"Normal", "[", 
      RowBox[{"pricesTS", "[", "\"\<Values\>\"", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"nTotal", "=", 
     RowBox[{"Length", "[", "rawPrices", "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Successfully loaded \>\"", ",", "nTotal", 
      ",", "\"\< trading days from \>\"", ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"DateString", "[", 
       RowBox[{
        RowBox[{"First", "[", "tradingDates", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"\"\<MonthName\>\"", ",", "\"\< \>\"", ",", "\"\<Year\>\""}],
          "}"}]}], "]"}], ",", "\"\< to \>\"", ",", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{"DateString", "[", 
       RowBox[{
        RowBox[{"Last", "[", "tradingDates", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"\"\<MonthName\>\"", ",", "\"\< \>\"", ",", "\"\<Year\>\""}],
          "}"}]}], "]"}], ",", "\"\<.\>\""}], "]"}], ";"}]}]}]], "Input",
 CellLabel->"In[1]:=",ExpressionUUID->"e0f53582-dd49-445a-9468-f3c1be0882ef"],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"Fetching historical daily data for \"\>", 
   "\[InvisibleSpace]", "\<\"SPY\"\>", "\[InvisibleSpace]", "\<\"...\"\>"}],
  SequenceForm["Fetching historical daily data for ", "SPY", "..."],
  Editable->False]], "Print",
 CellChangeTimes->{4.002501456391304*^9},
