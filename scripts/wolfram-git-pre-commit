#!/usr/bin/env bash
# Git pre-commit hook for Wolfram notebooks
# Ensures companion formats (Markdown, etc.) are generated and staged for any staged .nb files.

set -e

# Determine repository root
REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Path to the exporter script
CONFIG_EXPORTER="$(git config --get wolfram.exporterPath 2>/dev/null || true)"
if [ -n "$CONFIG_EXPORTER" ] && [ -f "$CONFIG_EXPORTER" ]; then
  EXPORTER="$CONFIG_EXPORTER"
elif command -v wolfram-git-export-formats.wls >/dev/null 2>&1; then
  EXPORTER="$(command -v wolfram-git-export-formats.wls)"
elif [ -f "$SCRIPT_DIR/wolfram-git-export-formats.wls" ]; then
  EXPORTER="$SCRIPT_DIR/wolfram-git-export-formats.wls"
elif [ -f "$REPO_ROOT/scripts/wolfram-git-export-formats.wls" ]; then
  EXPORTER="$REPO_ROOT/scripts/wolfram-git-export-formats.wls"
else
  EXPORTER="wolfram-git-export-formats.wls"
fi

if [ ! -x "$EXPORTER" ]; then
  chmod +x "$EXPORTER" 2>/dev/null || true
fi

# Find all staged .nb files (Added, Copied, Modified)
STAGED_NB_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.nb$' || true)

# Find all deleted .nb files
DELETED_NB_FILES=$(git diff --cached --name-only --diff-filter=D | grep -E '\.nb$' || true)

# Handle deleted .nb files: remove corresponding .md companion if it exists in git index
if [ -n "$DELETED_NB_FILES" ]; then
  while IFS= read -r file; do
    [ -z "$file" ] && continue
    companion="${file%.nb}.md"
    if git ls-files --error-unmatch "$companion" >/dev/null 2>&1; then
      echo "[pre-commit] Removing companion markdown for deleted notebook: $companion"
      git rm -q "$companion" 2>/dev/null || rm -f "$companion"
    fi
  done <<< "$DELETED_NB_FILES"
fi

# Handle added/modified .nb files
if [ -n "$STAGED_NB_FILES" ]; then
  echo "[pre-commit] Processing staged Wolfram notebooks..."
  while IFS= read -r nb_file; do
    [ -z "$nb_file" ] && continue
    abs_nb="$REPO_ROOT/$nb_file"
    if [ -f "$abs_nb" ]; then
      echo "[pre-commit] Exporting companion formats for: $nb_file"
      generated_files=$("$EXPORTER" "$abs_nb")
      if [ -n "$generated_files" ]; then
        while IFS= read -r gen_file; do
          [ -z "$gen_file" ] && continue
          # Stage the generated file
          git add "$gen_file"
          echo "[pre-commit] Staged companion: $(git ls-files --full-name "$gen_file" 2>/dev/null || basename "$gen_file")"
        done <<< "$generated_files"
      fi
    fi
  done <<< "$STAGED_NB_FILES"
fi

exit 0
